{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "name": "Primary",
          "slug": "primary",
          "color": "#3b82f6"
        },
        {
          "name": "Secondary",
          "slug": "secondary",
          "color": "#1e40af"
        },
        {
          "name": "Background",
          "slug": "background",
          "color": "#ffffff"
        },
        {
          "name": "Foreground",
          "slug": "foreground",
          "color": "#0a0a0a"
        },
        {
          "name": "Muted",
          "slug": "muted",
          "color": "#f1f5f9"
        },
        {
          "name": "Muted Foreground",
          "slug": "muted-foreground",
          "color": "#64748b"
        },
        {
          "name": "Border",
          "slug": "border",
          "color": "#e2e8f0"
        },
        {
          "name": "Destructive",
          "slug": "destructive",
          "color": "#ef4444"
        },
        {
          "name": "Success",
          "slug": "success",
          "color": "#22c55e"
        },
        {
          "name": "Warning",
          "slug": "warning",
          "color": "#f59e0b"
        }
      ]
    },
    "typography": {
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.875rem"
        },
        {
          "name": "Base",
          "slug": "base",
          "size": "1rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.125rem"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "1.25rem"
        },
        {
          "name": "2XL",
          "slug": "2xl",
          "size": "1.5rem"
        },
        {
          "name": "3XL",
          "slug": "3xl",
          "size": "1.875rem"
        },
        {
          "name": "4XL",
          "slug": "4xl",
          "size": "2.25rem"
        }
      ],
      "fontFamilies": [
        {
          "name": "Inter",
          "slug": "inter",
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        },
        {
          "name": "JetBrains Mono",
          "slug": "jetbrains-mono",
          "fontFamily": "'JetBrains Mono', 'Courier New', monospace"
        }
      ],
      "customFontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1536px"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "1rem",
        "bottom": "0",
        "left": "1rem"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--secondary)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "600",
          "lineHeight": "1.2",
          "fontFamily": "var(--wp--preset--font-family--inter)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4xl)",
          "fontWeight": "600"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3xl)",
          "fontWeight": "600"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2xl)",
          "fontWeight": "600"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--background)"
        },
        "border": {
          "radius": "0.375rem"
        },
        "spacing": {
          "padding": {
            "top": "0.5rem",
            "right": "1rem",
            "bottom": "0.5rem",
            "left": "1rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--secondary)"
          }
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "spacing": {
          "margin": {
            "bottom": "1rem"
          }
        }
      },
      "core/heading": {
        "spacing": {
          "margin": {
            "top": "1.5rem",
            "bottom": "1rem"
          }
        }
      }
    }
  }
}
