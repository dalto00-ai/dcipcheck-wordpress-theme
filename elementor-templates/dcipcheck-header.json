{
  "title": "DCIPCHECK Header",
  "type": "header",
  "version": "0.4",
  "page_settings": {
    "content_wrapper_html_tag": "header",
    "background_background": "classic",
    "background_color": "#ffffff",
    "border_border": "solid",
    "border_width": {
      "unit": "px",
      "size": 1,
      "sizes": []
    },
    "border_color": "#e2e8f0"
  },
  "content": [
    {
      "id": "header-container",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "full",
        "flex_direction": "row",
        "flex_align_items": "center",
        "flex_justify_content": "space-between",
        "padding": {
          "unit": "px",
          "top": "16",
          "right": "24",
          "bottom": "16",
          "left": "24",
          "isLinked": false
        }
      },
      "elements": [
        {
          "id": "logo-section",
          "elType": "container",
          "isInner": true,
          "settings": {
            "flex_direction": "row",
            "flex_align_items": "center",
            "flex_gap": {
              "unit": "px",
              "size": 12,
              "sizes": []
            }
          },
          "elements": [
            {
              "id": "logo-image",
              "elType": "widget",
              "widgetType": "image",
              "settings": {
                "image": {
                  "url": "[YOUR_LOGO_URL]"
                },
                "image_size": "custom",
                "image_custom_dimension": {
                  "width": "40",
                  "height": "40"
                },
                "align": "left"
              }
            },
            {
              "id": "site-title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "DCIPCHECK",
                "header_size": "h1",
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "px",
                  "size": 24,
                  "sizes": []
                },
                "typography_font_weight": "600",
                "color": "#0a0a0a"
              }
            }
          ]
        },
        {
          "id": "header-controls",
          "elType": "container",
          "isInner": true,
          "settings": {
            "flex_direction": "row",
            "flex_align_items": "center",
            "flex_gap": {
              "unit": "px",
              "size": 8,
              "sizes": []
            }
          },
          "elements": [
            {
              "id": "language-selector",
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "Language",
                "button_type": "default",
                "align": "right",
                "size": "sm"
              }
            },
            {
              "id": "theme-toggle",
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "Theme",
                "button_type": "default",
                "align": "right",
                "size": "sm"
              }
            }
          ]
        }
      ]
    }
  ]
}
